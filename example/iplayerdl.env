# Example iplayerdl environment file (KEY=VALUE lines).
#
# Fill in your secrets here and keep this file out of git and the Nix
# store. Load it with the NixOS module's environmentFile option
# (e.g. environmentFile = "/run/secrets/iplayerdl.env"), a systemd
# EnvironmentFile= directive, or `set -a; source iplayerdl.env; set +a`.
# Blank lines and lines starting with # are ignored.
#
# Keys set under config.toml [environment] override these, so keep each
# secret in one place only (here).

TMDB_API_KEY=
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
CBC_EMAIL=
CBC_PASSWORD=
